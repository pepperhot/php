{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advisory PHP",
  "type": "object",
  "required": ["schema_version", "id", "title", "published", "verified_on", "cves", "upstream", "distro_fixes", "mitigations", "sources"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "id": {"type": "string", "pattern": "^[A-Z0-9_-]+$"},
    "title": {"type": "string"},
    "published": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "verified_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "cves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "summary"],
        "properties": {
          "id": {"type": "string", "pattern": "^CVE-\\d{4}-\\d{4,}$"},
          "ghsa": {"type": "string"},
          "summary": {"type": "string"},
          "cvss_v4": {"type": "object"},
          "cwe": {"type": "array", "items": {"type": "string"}},
          "sapi_exposure": {"type": "object"}
        }
      }
    },
    "upstream": {
      "type": "object",
      "required": ["branches", "min_supported_branch"],
      "properties": {
        "branches": {"type": "object"},
        "min_supported_branch": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
        "eol_note": {"type": "string"},
        "source_backports": {"type": "object"}
      }
    },
    "distro_fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["distro", "release", "source_package", "fixed_version", "advisory", "source_url", "verified_on"],
        "properties": {
          "distro": {"type": "string", "enum": ["debian", "ubuntu"]},
          "release": {"type": "string"},
          "source_package": {"type": "string", "pattern": "^php[0-9.]+$"},
          "fixed_version": {"type": "string"},
          "advisory": {"type": "string"},
          "cves": {"type": "array", "items": {"type": "string"}},
          "source_url": {"type": "string", "pattern": "^https://"},
          "verified_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "note": {"type": "string"}
        }
      }
    },
    "third_party_repos": {"type": "object"},
    "mitigations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "directive", "cves", "branches", "scope"],
        "properties": {
          "id": {"type": "string"},
          "directive": {"type": "string"},
          "recommended": {"type": "string"},
          "recommended_max_bytes": {"type": "integer", "minimum": 0},
          "default": {"type": "string"},
          "cves": {"type": "array", "items": {"type": "string"}},
          "branches": {"type": "string"},
          "scope": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "publisher", "type", "title", "url", "verified_on"],
        "properties": {
          "id": {"type": "string"},
          "publisher": {"type": "string"},
          "type": {"type": "string", "enum": ["primary", "secondary"]},
          "title": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"},
          "verified_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
        }
      }
    }
  }
}
