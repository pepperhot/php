  "mitigations": [
    {
      "id": "MIT-UPLOAD-PROGRESS",
      "directive": "session.upload_progress.enabled",
      "recommended": "0",
      "default": "1",
      "cves": [
        "CVE-2026-109619"
      ],
      "branches": "*",
      "scope": "Bloque les chemins de session confirmés uniquement. Doit être posé dans php.ini, le pool FPM (php_admin_flag) ou la configuration serveur ; ini_set() et .user.ini sont inefficaces. Redémarrer tous les workers."
    },
    {
      "id": "MIT-FATAL-BACKTRACES",
      "directive": "fatal_error_backtraces",
      "recommended": "0",
      "default": "1",
      "cves": [
        "CVE-2026-109619"
      ],
      "branches": "8.5",
      "scope": "PHP 8.5 uniquement. Bloque le seul chemin fatal backtrace confirmé."
    },
    {
      "id": "MIT-MEMORY-LIMIT",
      "directive": "memory_limit",
      "recommended": "-1",
      "default": "128M",
      "cves": [
        "CVE-2026-109618"
      ],
      "branches": "*",
      "scope": "Supprime le déclenchement OOM interne. Effet de bord : risque d'épuisement mémoire de l'hôte ; à combiner avec une limite cgroup qui tue uniquement le worker. Ne pas utiliser RLIMIT_AS / RLIMIT_DATA."
    },
    {
      "id": "MIT-POST-MAX-SIZE",
      "directive": "post_max_size",
      "recommended_max_bytes": 33554432,
      "default": "8M",
      "cves": [
        "CVE-2026-109618"
      ],
      "branches": "*",
      "scope": "8M sans upload, 32M avec upload ; upload_max_filesize < post_max_size. Insuffisant seul : les requêtes sans Content-Length exploitable contournent la vérification initiale."
    }
  ],
