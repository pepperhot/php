{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paramètres php-vuln-audit",
  "type": "object",
  "required": ["schema_version", "mode", "environment", "advisories", "detection_rules", "reports_dir", "collect", "detection", "environments"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "mode": {"type": "string", "enum": ["audit"], "description": "Seul le mode audit existe : l'outil ne modifie jamais le système."},
    "environment": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "advisories": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "detection_rules": {"type": "string"},
    "reports_dir": {"type": "string"},
    "log_level": {"type": "string", "enum": ["DEBUG", "INFO", "WARNING", "ERROR"]},
    "collect": {
      "type": "object",
      "required": ["command_timeout_seconds", "php_binary_globs", "php_conf_root"],
      "additionalProperties": false,
      "properties": {
        "command_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "php_binary_globs": {"type": "array", "items": {"type": "string"}},
        "php_conf_root": {"type": "string"},
        "apache_conf_root": {"type": "string"},
        "web_roots": {"type": "array", "items": {"type": "string"}},
        "max_htaccess_files": {"type": "integer", "minimum": 0},
        "scan_proc_maps": {"type": "boolean"},
        "systemd_units": {"type": "array", "items": {"type": "string"}},
        "containers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "exec_version_probe": {"type": "boolean"}
          }
        },
        "http_probes": {"type": "array", "items": {"type": "string", "pattern": "^https?://"}}
      }
    },
    "detection": {
      "type": "object",
      "required": ["enabled", "log_sources"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "max_file_age_days": {"type": "integer", "minimum": 1},
        "max_lines_per_file": {"type": "integer", "minimum": 1},
        "max_samples_per_rule": {"type": "integer", "minimum": 0, "maximum": 100},
        "min_hits_to_flag": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "low": {"type": "integer", "minimum": 1},
            "medium": {"type": "integer", "minimum": 1},
            "high": {"type": "integer", "minimum": 1}
          }
        },
        "log_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "paths"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string"},
              "type": {"type": "string", "enum": ["access", "error", "fpm", "system", "waf"]},
              "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["allow_remediation_script"],
        "properties": {
          "allow_remediation_script": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
