{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Règles de détection",
  "type": "object",
  "required": ["schema_version", "verified_on", "rules"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "verified_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "applies_to", "pattern", "severity", "cves", "rationale", "false_positives"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^DR-[0-9]{3}$"},
          "title": {"type": "string"},
          "applies_to": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["access", "error", "fpm", "system", "waf"]}},
          "pattern": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "cves": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string"},
          "false_positives": {"type": "string"}
        }
      }
    }
  }
}
